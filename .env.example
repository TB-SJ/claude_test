# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# ---------------------------------------------------------------------------

# Local server
PORT=3000
# Base URL the OAuth providers redirect back to. Must match the redirect URIs
# registered in the Google Cloud Console and Azure App Registration.
BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Token encryption
# ---------------------------------------------------------------------------
# 32-byte key, hex-encoded (64 hex chars). Used to encrypt persisted OAuth
# tokens at rest with AES-256-GCM. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Google Calendar (Google Cloud Console -> APIs & Services -> Credentials)
# Authorized redirect URI: ${BASE_URL}/auth/google/callback
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Outlook / Microsoft Graph (Azure Portal -> App registrations)
# Redirect URI (type: Web): ${BASE_URL}/auth/outlook/callback
# For personal + work/school accounts use tenant "common".
# ---------------------------------------------------------------------------
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=common

# ---------------------------------------------------------------------------
# Voice interface (OpenAI Whisper speech-to-text + chat model for intent)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
# Optional overrides:
OPENAI_MODEL=gpt-4o-mini
WHISPER_MODEL=whisper-1

# ---------------------------------------------------------------------------
# Claude (Anthropic) — optional natural-language voice understanding.
# Get a key at https://console.anthropic.com (pay-as-you-go, separate from any
# claude.ai subscription). When set, Claude parses voice commands; the built-in
# rules parser stays as an automatic fallback.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Microphone capture (node-record-lpcm16). Requires SoX (`sox`/`rec`) or ALSA
# (`arecord`) installed on the machine running the server.
AUDIO_RECORDER=sox
AUDIO_SAMPLE_RATE=16000
AUDIO_SECONDS=5

# ---------------------------------------------------------------------------
# Web dashboard login (single-user)
# ---------------------------------------------------------------------------
# Leave empty to DISABLE the login gate (fine for localhost). Set a password
# before exposing the app to the internet (ngrok/cloud). Optional session
# secret; if omitted it is derived from the password.
APP_PASSWORD=
APP_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Persistence backend (optional)
# ---------------------------------------------------------------------------
# By default, tokens + tasks are stored in local files under data/. On a host
# with an ephemeral disk (Render/Railway/Fly free tiers), set these to persist
# them in Supabase instead. Create a free project, run the SQL in
# docs/DEPLOY.md, then paste your project URL and the *service_role* key here.
# Tokens stay AES-encrypted at rest; the key never leaves this app.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ---------------------------------------------------------------------------
# Push notifications (optional): daily brief + event reminders
# ---------------------------------------------------------------------------
# Generate the VAPID pair with `npm run vapid` and paste the output here (and on
# your host). Keep them stable — the public key is baked into every device
# subscription. CRON_SECRET guards /cron/tick (must match your scheduler).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
CRON_SECRET=
# Local time for the morning brief, and how many minutes before an event to remind.
BRIEF_TIME=07:00
REMINDER_LEAD_MINUTES=10
